---
/**
 * Résumé, built from the same content files as the rest of the site, so the two never disagree.
 * The build prints this page to /resume.pdf (scripts/build-resume-pdf.mjs).
 * No phone number by design: email and public profiles only.
 */
import Base from '~/layouts/Base.astro';
import Icon from '~/components/Icon.astro';
import { getWork } from '~/lib/collections';
import { experience, profile, projects, skills } from '~/lib/site';

const work = await getWork();
const site = Astro.site!;
const bare = (href: string) => href.replace(/^https?:\/\//, '').replace(/\/$/, '');
const contacts = [
  { label: profile.email, href: `mailto:${profile.email}` },
  ...profile.links.map((link) => ({ label: bare(link.href).replace(/^www\./, ''), href: link.href })),
  { label: bare(site.href), href: site.href },
];
const alsoBuilt = projects.filter((project) => !project.href).slice(0, 4);
---

<Base title="Résumé" description={`Résumé of ${profile.name}, ${profile.title}. ${profile.seoDescription}`}>
  <div class="container-page py-10 md:py-16">
    <div class="resume-actions mx-auto mb-6 flex max-w-[52rem] flex-wrap items-center justify-between gap-3">
      <a href="/" class="tap group inline-flex items-center gap-1.5 text-sm text-muted hover:text-text">
        <Icon name="arrow-left" size={14} class="transition-transform group-hover:-translate-x-0.5" />
        Home
      </a>
      <a href="/resume.pdf" class="btn btn-primary btn-sm" download="Ravikumar-MN-Resume.pdf">
        <Icon name="file-text" />
        Download PDF
      </a>
    </div>

    <article class="sheet mx-auto max-w-[52rem]" aria-labelledby="resume-name">
      <header>
        <h1 id="resume-name" class="name">{profile.name}</h1>
        <p class="role">{profile.title} · {profile.location}</p>
        <ul class="contacts" aria-label="Contact">
          {
            contacts.map((contact) => (
              <li>
                <a href={contact.href}>{contact.label}</a>
              </li>
            ))
          }
        </ul>
        <p class="summary">{profile.subline}</p>
      </header>

      <section aria-labelledby="r-experience">
        <h2 id="r-experience">Experience</h2>
        {
          experience.map((job) => (
            <div class="entry">
              <div class="entry-head">
                <h3>
                  {job.role} <span class="org">· {job.org}</span>
                </h3>
                <p class="dates">
                  {job.start} – {job.end}
                </p>
              </div>
              <p class="meta">
                {job.type} · {job.location}
              </p>
              <ul class="bullets">
                {job.highlights.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </section>

      <section aria-labelledby="r-projects">
        <h2 id="r-projects">Selected systems</h2>
        {
          work.map((entry) => (
            <div class="entry">
              <div class="entry-head">
                <h3>
                  <a href={new URL(`/work/${entry.id}`, site).href}>{entry.data.title}</a>
                </h3>
                <p class="dates">{entry.data.org}</p>
              </div>
              <p class="detail">{entry.data.summary}</p>
              <p class="figures">
                {entry.data.metrics
                  .filter((metric) => /^[<>−+-]?\d/.test(metric.value))
                  .slice(0, 3)
                  .map((metric) => `${metric.value} ${metric.label}`)
                  .join('  ·  ')}
              </p>
            </div>
          ))
        }
        <div class="entry">
          <h3 class="also">Also built</h3>
          <ul class="bullets">
            {
              alsoBuilt.map((project) => (
                <li>
                  <strong>{project.title}.</strong> {project.detail} <span class="figure">{project.metric}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section aria-labelledby="r-skills">
        <h2 id="r-skills">Skills</h2>
        <dl class="skills">
          {
            skills.map((group) => (
              <div>
                <dt>{group.group}</dt>
                <dd>{group.items.join(', ')}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section aria-labelledby="r-education">
        <h2 id="r-education">Education</h2>
        <div class="entry">
          <div class="entry-head">
            <h3>
              {profile.education.degree} <span class="org">· {profile.education.school}</span>
            </h3>
            <p class="dates">{profile.education.period}</p>
          </div>
          {profile.education.note && <p class="meta">{profile.education.note}</p>}
        </div>
        <p class="detail mt-3"><strong>Certifications:</strong> {profile.certifications.join('; ')}.</p>
      </section>
    </article>
  </div>
</Base>

<style>
  /* On screen the résumé reads as a sheet; in print it is plain black on white. */
  .sheet {
    padding: 2rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface-1);
    color: var(--text-muted);
    font-size: 0.9375rem;
    line-height: 1.55;
  }
  @media (min-width: 48rem) {
    .sheet {
      padding: 3.5rem 4rem;
    }
  }

  .name {
    color: var(--text);
    font-size: var(--text-2xl);
    letter-spacing: -0.03em;
  }
  .role {
    margin-top: 0.375rem;
    color: var(--text);
    font-size: var(--text-md);
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .contacts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin-top: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }
  .contacts a,
  .entry-head a {
    color: var(--accent-text);
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, var(--accent) 35%, transparent);
    text-underline-offset: 3px;
  }
  .summary {
    margin-top: 1.25rem;
    max-width: 68ch;
  }

  section {
    margin-top: 2rem;
  }
  h2 {
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
    color: var(--text-subtle);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .entry {
    margin-top: 1.125rem;
    break-inside: avoid;
  }
  .entry-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.125rem 1rem;
  }
  h3 {
    color: var(--text);
    font-size: 1rem;
    letter-spacing: -0.01em;
    line-height: 1.35;
  }
  .org {
    color: var(--text-muted);
    font-weight: 500;
  }
  .also {
    font-size: 0.9375rem;
  }
  .dates,
  .figures,
  .figure {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }
  .dates {
    color: var(--text-subtle);
    white-space: nowrap;
  }
  .meta {
    color: var(--text-subtle);
    font-size: 0.875rem;
  }
  .detail {
    margin-top: 0.25rem;
  }
  .figures {
    margin-top: 0.25rem;
    color: var(--text);
    white-space: pre-wrap;
  }
  .figure {
    color: var(--text);
  }
  .bullets {
    margin-top: 0.5rem;
  }
  .bullets li {
    position: relative;
    padding-left: 1rem;
  }
  .bullets li + li {
    margin-top: 0.25rem;
  }
  .bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.75em;
    width: 0.45rem;
    height: 1px;
    background: var(--text-subtle);
  }
  strong {
    color: var(--text);
    font-weight: 600;
  }
  .skills {
    display: grid;
    gap: 0.5rem;
    margin-top: 1rem;
  }
  .skills div {
    display: grid;
    gap: 0.125rem 1rem;
  }
  @media (min-width: 40rem) {
    .skills div {
      grid-template-columns: 11rem 1fr;
    }
  }
  .skills dt {
    color: var(--text);
    font-weight: 500;
  }

  @media print {
    @page {
      size: Letter;
      margin: 0.5in 0.6in;
    }
    :global(.site-header),
    :global(body > footer),
    :global(.skip-link),
    :global(.hero-glow),
    .resume-actions {
      display: none !important;
    }
    :global(html),
    :global(body) {
      background: #fff !important;
    }
    :global(main) > div {
      padding: 0 !important;
      max-width: none;
    }
    .sheet {
      --text: #111214;
      --text-muted: #2e3136;
      --text-subtle: #5d6168;
      --border: #d9d9d4;
      --accent: #0e7468;
      --accent-text: #0b6157;
      max-width: none;
      padding: 0;
      border: 0;
      border-radius: 0;
      background: #fff;
      font-size: 9.6pt;
      line-height: 1.42;
    }
    .name {
      font-size: 21pt;
    }
    .role {
      font-size: 11.5pt;
    }
    .contacts,
    .dates,
    .figures,
    .figure {
      font-size: 8.4pt;
    }
    .meta {
      font-size: 8.8pt;
    }
    .summary {
      margin-top: 0.7rem;
      max-width: none;
    }
    h3 {
      font-size: 10.2pt;
    }
    section {
      margin-top: 1.05rem;
    }
    h2 {
      padding-bottom: 0.25rem;
      font-size: 7.6pt;
    }
    .entry {
      margin-top: 0.6rem;
    }
    .bullets {
      margin-top: 0.25rem;
    }
    .bullets li + li {
      margin-top: 0.1rem;
    }
    .skills {
      gap: 0.2rem;
      margin-top: 0.5rem;
    }
    .skills div {
      grid-template-columns: 9.5rem 1fr;
    }
  }
</style>
