---
import { render } from 'astro:content';
import Post from '~/layouts/Post.astro';
import { getPosts } from '~/lib/collections';

// Old Jekyll URLs were /blogs/<slug> (no trailing slash); `build.format: 'file'` keeps them identical.
export async function getStaticPaths() {
  const posts = await getPosts();
  // Sorted newest first, so the previous entry is the newer post.
  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: { post, newer: posts[index - 1], older: posts[index + 1] },
  }));
}

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
---

<Post post={post} headings={headings.filter((heading) => heading.depth <= 3)} newer={newer} older={older}>
  <Content />
</Post>
