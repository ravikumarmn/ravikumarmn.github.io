---
import { render } from 'astro:content';
import CaseStudy from '~/layouts/CaseStudy.astro';
import { getWork } from '~/lib/collections';
import ArchitectureFigure from '~/components/mdx/ArchitectureFigure.astro';
import Callout from '~/components/mdx/Callout.astro';
import Metric from '~/components/mdx/Metric.astro';
import MetricGrid from '~/components/mdx/MetricGrid.astro';
import StackList from '~/components/mdx/StackList.astro';
import Todo from '~/components/mdx/Todo.astro';
import Verify from '~/components/mdx/Verify.astro';

export async function getStaticPaths() {
  const work = await getWork();
  return work.map((entry, index) => ({
    params: { slug: entry.id },
    props: { entry, prev: work[index - 1], next: work[index + 1] },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const components = { ArchitectureFigure, Callout, Metric, MetricGrid, StackList, Todo, Verify };
---

<CaseStudy entry={entry} prev={prev} next={next}>
  <Content components={components} />
</CaseStudy>
