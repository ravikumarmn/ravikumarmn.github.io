---
import Base from '~/layouts/Base.astro';
import Icon from '~/components/Icon.astro';
import { getPosts } from '~/lib/collections';

const posts = await getPosts();
const byYear = Map.groupBy(posts, (post) => post.data.date.getFullYear());
---

<Base title="Writing" description="Explainers with working code on retrieval, transformers, embeddings, and PyTorch.">
  <section class="container-page pt-12 pb-24 md:pt-20">
    <p class="eyebrow">Writing</p>
    <h1 class="mt-3 text-2xl md:text-3xl">Notes from the bench</h1>
    <p class="mt-5 max-w-[60ch] text-muted">
      Explainers with working code: retrieval, transformers, embeddings, and the PyTorch underneath.
    </p>

    {
      [...byYear].map(([year, items]) => (
        <div class="mt-14 grid gap-4 md:grid-cols-[8rem_1fr]">
          <h2 class="font-mono text-sm text-subtle">{year}</h2>
          <ul class="border-t border-border">
            {items.map((post) => (
              <li class="border-b border-border">
                <a href={`/blogs/${post.id}`} class="group flex items-start justify-between gap-6 py-5">
                  <span class="min-w-0">
                    <span class="block font-medium text-text group-hover:text-accent-text">{post.data.title}</span>
                    {post.data.description && (
                      <span class="mt-1 block max-w-[68ch] text-sm text-subtle">{post.data.description}</span>
                    )}
                  </span>
                  <span class="hidden shrink-0 font-mono text-xs text-subtle sm:block">{post.data.topic}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
    <a href="/" class="tap link mt-14 inline-flex items-center gap-1.5 text-sm">
      <Icon name="arrow-left" size={14} /> Back home
    </a>
  </section>
</Base>
