---
import Base from '~/layouts/Base.astro';
import Icon from '~/components/Icon.astro';
import { getPosts, readingTime } from '~/lib/collections';

const posts = (await getPosts()).map((post) => ({ post, minutes: readingTime(post.body) }));
const featured = posts.filter(({ post }) => post.data.featured);
const years = [...new Set(posts.map(({ post }) => post.data.date.getFullYear()))];
const byYear = years.map((year) => ({
  year,
  entries: posts.filter(({ post }) => post.data.date.getFullYear() === year),
}));
const topics = new Set(posts.map(({ post }) => post.data.topic)).size;
const month = (date: Date) => date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
const day = (date: Date) => date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
---

<Base
  title="Writing"
  description="Explainers with working code on retrieval, transformers, embeddings, and PyTorch."
  glow
>
  <section class="container-page pt-12 pb-24 md:pt-20" aria-labelledby="writing-title">
    <header class="max-w-2xl">
      <p class="enter eyebrow">Writing</p>
      <h1 id="writing-title" class="enter enter-1 mt-4 text-2xl leading-[1.08] tracking-[-0.03em] md:text-3xl">
        Notes from the bench
      </h1>
      <p class="enter enter-2 mt-5 text-md leading-relaxed text-muted">
        Explainers with working code: retrieval, transformers, embeddings, and the PyTorch underneath.
      </p>
      <p class="enter enter-3 mt-6 font-mono text-xs text-subtle">
        {posts.length} posts · {topics} topics · {years.join(', ')}
      </p>
    </header>

    {
      featured.length > 0 && (
        <section class="mt-14 md:mt-16" aria-labelledby="featured-title">
          <h2 id="featured-title" class="eyebrow">
            Start here
          </h2>
          <ul class="mt-5 grid gap-3 md:grid-cols-2 md:gap-4">
            {featured.map(({ post, minutes }) => (
              <li data-reveal>
                <a href={`/blogs/${post.id}`} class="feature group">
                  <span class="flex items-start justify-between gap-4">
                    <span class="eyebrow">{post.data.topic}</span>
                    <Icon
                      name="arrow-up-right"
                      size={16}
                      class="shrink-0 text-subtle transition-[color,transform] duration-200 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-accent"
                    />
                  </span>
                  <span class="feature-title mt-3 block font-semibold text-balance text-text md:mt-4">
                    {post.data.title}
                  </span>
                  {post.data.description && (
                    <span class="mt-2.5 line-clamp-3 block text-sm leading-relaxed text-muted md:mt-3">
                      {post.data.description}
                    </span>
                  )}
                  <span class="mt-auto block pt-5 font-mono text-xs text-subtle md:pt-6">
                    <time datetime={post.data.date.toISOString()}>{month(post.data.date)}</time> · {minutes} min read
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="mt-16 md:mt-20" aria-labelledby="all-title">
      <h2 id="all-title" class="eyebrow">All posts</h2>
      {
        byYear.map(({ year, entries }) => (
          <div class="year mt-5" data-reveal>
            <h3 class="year-label font-mono text-xs text-subtle tabular-nums">
              {year}
              <span class="sr-only">, {entries.length} posts</span>
            </h3>
            <ul class="year-list">
              {entries.map(({ post, minutes }) => (
                <li>
                  <a href={`/blogs/${post.id}`} class="row group">
                    <span class="row-main">
                      <span class="row-title block font-medium text-pretty text-text transition-colors group-hover:text-accent-text">
                        {post.data.title}
                      </span>
                      {post.data.description && (
                        <span class="row-desc mt-1.5 block text-sm leading-relaxed text-subtle">
                          {post.data.description}
                        </span>
                      )}
                      <span class="row-sub mt-2.5 block font-mono text-xs text-subtle">
                        {post.data.topic}
                        <span class="row-sub-date">
                          {' · '}
                          {day(post.data.date)} · {minutes} min
                        </span>
                      </span>
                    </span>
                    <span class="row-topic font-mono text-xs text-subtle">{post.data.topic}</span>
                    <span class="row-meta font-mono text-xs text-subtle tabular-nums">
                      <time datetime={post.data.date.toISOString()}>{day(post.data.date)}</time>
                      <span>{minutes} min</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </section>
  </section>
</Base>

<style>
  .feature {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface-1);
    transition:
      border-color var(--dur) var(--ease-out),
      box-shadow var(--dur) var(--ease-out),
      translate var(--dur) var(--ease-out);
  }
  .feature-title {
    font-size: 1.1875rem;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }
  @media (min-width: 48rem) {
    .feature {
      padding: 1.75rem 2rem;
    }
    .feature-title {
      font-size: var(--text-lg);
      line-height: 1.25;
    }
  }
  .feature:hover {
    border-color: color-mix(in oklab, var(--accent) 40%, var(--border));
    box-shadow: var(--shadow-lift);
  }
  @media (prefers-reduced-motion: no-preference) {
    .feature:hover {
      translate: 0 -2px;
    }
  }

  /*
   * The archive. Phones: one column, metadata on one line under the title.
   * Tablets and up: year | title + description | topic | date and length, so each column scans on its own.
   */
  .year {
    border-top: 1px solid var(--border);
  }
  .year-label {
    padding-block: 1rem 0.25rem;
  }
  .year-list > li + li {
    border-top: 1px solid var(--border);
  }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    padding: 1.125rem 0.75rem;
    margin-inline: -0.75rem;
    border-radius: var(--radius-sm);
    transition: background-color var(--dur-fast) var(--ease-out);
  }
  .row:hover {
    background: var(--surface-1);
  }
  .row-main {
    min-width: 0;
  }
  .row-desc {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    max-width: 62ch;
    text-wrap: pretty;
  }
  .row-sub-date {
    white-space: nowrap;
  }
  .row-topic,
  .row-meta {
    display: none;
  }

  @media (min-width: 48rem) {
    .year {
      display: grid;
      grid-template-columns: 6rem minmax(0, 1fr);
      gap: 1.5rem;
    }
    .year-label {
      padding-block: 1.375rem 0;
    }
    .row {
      grid-template-columns: minmax(0, 1fr) 6rem;
      column-gap: 2rem;
      align-items: baseline;
      padding-block: 1.25rem;
    }
    .row-sub-date {
      display: none;
    }
    .row-meta {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 0.25rem;
      text-align: right;
    }
  }

  @media (min-width: 64rem) {
    .row {
      grid-template-columns: minmax(0, 1fr) 17rem 4.5rem;
    }
    .row-sub {
      display: none;
    }
    .row-topic {
      display: block;
      line-height: 1.5;
      text-wrap: balance;
    }
  }
</style>
