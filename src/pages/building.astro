---
import Base from '~/layouts/Base.astro';
import { building } from '~/lib/site';
---

<Base
  title="Now building"
  description="Open projects that rebuild production work in public: evaluating LLM applications, fine-tuning and serving small open models, and reinforcement learning for reasoning and instruction following."
  glow
>
  <section class="container-page pt-12 pb-24 md:pt-20" aria-labelledby="building-title">
    <header class="max-w-2xl">
      <p class="enter eyebrow">Now building</p>
      <h1 id="building-title" class="enter enter-1 mt-4 text-2xl leading-[1.08] tracking-[-0.03em] md:text-3xl">
        Open projects, published as I measure them
      </h1>
      <p class="enter enter-2 mt-5 text-md leading-relaxed text-muted">
        Three areas every team shipping LLMs runs into: evaluation, fine-tuning and serving, and reinforcement
        learning. Each project builds on work I’ve done in production and rebuilds it in public, with code and numbers
        anyone can reproduce. Open models run on a single 24&nbsp;GB GPU.
      </p>
      <p class="enter enter-3 mt-4 text-muted">
        Results are added as they are measured, with methods and confidence intervals, including where my approach
        loses. Each project becomes a full case study when it ships.
      </p>
    </header>

    <ol class="mt-14 grid gap-12 md:mt-16">
      {
        building.map((project, i) => (
          <li id={project.slug} class="project" data-reveal>
            <div class="project-meta">
              <span class="font-mono text-xs text-subtle tabular-nums">0{i + 1}</span>
            </div>
            <div class="min-w-0">
              <h2 class="text-xl leading-snug text-pretty md:text-[1.625rem]">{project.title}</h2>
              <p class="mt-4 max-w-[var(--prose-max)] text-md leading-relaxed text-text">{project.summary}</p>
              <p class="builds-on mt-5 max-w-[var(--prose-max)] text-muted">
                <span class="eyebrow">Builds on</span>
                <span>
                  <a href={project.buildsOn.href} class="link">
                    {project.buildsOn.text}
                  </a>
                </span>
              </p>

              <div class="mt-8 grid gap-8 lg:grid-cols-2">
                <div class="lg:col-span-2">
                  <h3 class="eyebrow">Approach</h3>
                  <ul class="list mt-3">
                    {project.approach.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </div>
                <div>
                  <h3 class="eyebrow">What gets measured</h3>
                  <ul class="list mt-3">
                    {project.measures.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </div>
                <div>
                  <h3 class="eyebrow">What gets published</h3>
                  <ul class="list mt-3">
                    {project.publishes.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </div>
              </div>

              <ul class="mt-8 flex flex-wrap gap-1.5" aria-label="Tools">
                {project.stack.map((item) => (
                  <li class="chip">{item}</li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>
  </section>
</Base>

<style>
  .project {
    display: grid;
    gap: 1rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--border);
    scroll-margin-top: calc(var(--header-h) + 1.5rem);
  }
  @media (min-width: 64rem) {
    .project {
      grid-template-columns: 9rem minmax(0, 1fr);
      gap: 2rem;
    }
  }
  .project-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  @media (min-width: 64rem) {
    .project-meta {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
      padding-top: 0.5rem;
    }
  }
  .builds-on {
    display: grid;
    gap: 0.375rem;
    padding: 0.875rem 1rem;
    border-left: 2px solid var(--accent);
    background: var(--accent-soft);
    border-radius: 0 var(--radius) var(--radius) 0;
  }
  .builds-on .link {
    cursor: pointer;
  }
  .list {
    display: grid;
    gap: 0.6rem;
    max-width: var(--prose-max);
    color: var(--text-muted);
  }
  .list li {
    position: relative;
    padding-left: 1.125rem;
  }
  .list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.8em;
    width: 0.5rem;
    height: 1px;
    background: var(--text-subtle);
  }
</style>
