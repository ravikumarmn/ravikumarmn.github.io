---
import type { CollectionEntry } from 'astro:content';
import Base from './Base.astro';
import Icon from '~/components/Icon.astro';
import { articleJsonLd } from '~/lib/jsonld';
import '~/styles/prose.css';

interface Props {
  entry: CollectionEntry<'work'>;
  prev?: CollectionEntry<'work'>;
  next?: CollectionEntry<'work'>;
  /** The case study's h2s, for the jump bar. */
  sections?: { slug: string; text: string }[];
}

const { entry, prev, next, sections = [] } = Astro.props;
const { title, summary, role, org, period, metrics, stack } = entry.data;
const url = new URL(`/work/${entry.id}`, Astro.site);
// Facts the résumé doesn't state are left out rather than shown as blanks.
const facts = [
  { label: 'Role', value: role },
  { label: 'Context', value: org },
  { label: 'When', value: period },
  { label: 'Core stack', value: stack.slice(0, 3).join(', ') },
].filter((fact): fact is { label: string; value: string } => Boolean(fact.value));
const image = `/og/work/${entry.id}.png`;
---

<Base
  title={title}
  description={summary}
  image={image}
  type="article"
  jsonLd={articleJsonLd({ title, description: summary, url, image: new URL(image, Astro.site) })}
  glow
>
  <article>
    <header class="container-page pt-12 pb-12 md:pt-20">
      <a href="/#work" class="tap group inline-flex items-center gap-1.5 text-sm text-muted hover:text-text">
        <Icon name="arrow-left" size={14} class="transition-transform group-hover:-translate-x-0.5" />
        Selected work
      </a>
      <p class="enter eyebrow mt-10">Case study</p>
      <h1 class="enter enter-1 mt-4 max-w-[24ch] text-2xl leading-[1.08] tracking-[-0.03em] md:text-3xl">{title}</h1>
      <p class="enter enter-2 mt-5 max-w-[60ch] text-md leading-relaxed text-muted">{summary}</p>

      <dl class="enter enter-3 mt-10 grid grid-cols-2 gap-6 border-y border-border py-6 text-sm md:grid-cols-4">
        {
          facts.map((fact) => (
            <div>
              <dt class="eyebrow">{fact.label}</dt>
              <dd class="mt-1.5 text-text">{fact.value}</dd>
            </div>
          ))
        }
      </dl>

      <dl class="mt-6 grid grid-cols-1 gap-3 min-[30rem]:grid-cols-2 md:grid-cols-3">
        {
          metrics.slice(0, 3).map((metric) => (
            <div class="flex flex-col-reverse justify-end gap-1 rounded-lg border border-border bg-surface-1 p-5">
              <dt class="text-sm text-subtle">{metric.label}</dt>
              <dd class="font-mono text-2xl font-medium tracking-[-0.035em] text-text tabular-nums">{metric.value}</dd>
            </div>
          ))
        }
      </dl>
    </header>

    {
      sections.length > 1 && (
        <nav class="case-toc" aria-label="Sections" data-toc>
          <ul class="container-page flex gap-1">
            {sections.map((section) => (
              <li>
                <a href={`#${section.slug}`} class="case-toc-link">
                  {section.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <div class="container-page pt-12 pb-24 md:pt-16">
      <div class="prose case-prose">
        <slot />
      </div>
    </div>

    <nav class="container-page grid gap-4 border-t border-border py-12 sm:grid-cols-2" aria-label="More case studies">
      {
        prev ? (
          <a href={`/work/${prev.id}`} class="pager group">
            <span class="eyebrow inline-flex items-center gap-1.5">
              <Icon name="arrow-left" size={12} /> Previous
            </span>
            <span class="mt-2 block font-medium text-text group-hover:text-accent-text">{prev.data.title}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a href={`/work/${next.id}`} class="pager group sm:text-right">
            <span class="eyebrow inline-flex items-center gap-1.5">
              Next <Icon name="arrow-right" size={12} />
            </span>
            <span class="mt-2 block font-medium text-text group-hover:text-accent-text">{next.data.title}</span>
          </a>
        )
      }
    </nav>
  </article>
</Base>

<style>
  /* Jump bar: sticks under the site header on wide screens so Results is one click away. */
  .case-toc {
    display: none;
  }
  @media (min-width: 48rem) {
    .case-toc {
      display: block;
      position: sticky;
      top: var(--header-h);
      z-index: 40;
      border-block: 1px solid var(--border);
      background: color-mix(in oklab, var(--bg) 94%, transparent);
      backdrop-filter: saturate(1.4) blur(16px);
      -webkit-backdrop-filter: saturate(1.4) blur(16px);
    }
  }
  .case-toc-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    height: 2.75rem;
    padding-inline: 0.75rem;
    font-size: var(--text-sm);
    color: var(--text-subtle);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .case-toc li:first-child .case-toc-link {
    padding-left: 0;
  }
  .case-toc-link:hover,
  .case-toc-link[aria-current='true'] {
    color: var(--text);
  }
  .case-toc-link[aria-current='true']::after {
    content: '';
    position: absolute;
    inset: auto 0.75rem -1px;
    height: 1px;
    background: var(--accent);
  }
  .case-toc li:first-child .case-toc-link[aria-current='true']::after {
    left: 0;
  }
  @media (min-width: 48rem) {
    .case-prose :global(:where(h2, h3, h4)) {
      scroll-margin-top: calc(var(--header-h) + 2.75rem + 1rem);
    }
  }

  .pager {
    display: block;
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    transition: border-color var(--dur-fast) var(--ease-out);
  }
  .pager:hover {
    border-color: color-mix(in oklab, var(--accent) 40%, var(--border));
  }
</style>
