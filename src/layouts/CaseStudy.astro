---
import type { CollectionEntry } from 'astro:content';
import Base from './Base.astro';
import Icon from '~/components/Icon.astro';
import Metric from '~/components/mdx/Metric.astro';
import MetricGrid from '~/components/mdx/MetricGrid.astro';
import { articleJsonLd } from '~/lib/jsonld';
import '~/styles/prose.css';

interface Props {
  entry: CollectionEntry<'work'>;
  prev?: CollectionEntry<'work'>;
  next?: CollectionEntry<'work'>;
  /** The case study's h2s, for the jump bar. */
  sections?: { slug: string; text: string }[];
}

const { entry, prev, next, sections = [] } = Astro.props;
const { title, summary, role, org, period, metrics, stack } = entry.data;
const url = new URL(`/work/${entry.id}`, Astro.site);
// Facts the résumé doesn't state are left out rather than shown as blanks.
const facts = [
  { label: 'Role', value: role },
  { label: 'Context', value: org },
  { label: 'When', value: period },
  { label: 'Core stack', value: stack.slice(0, 3).join(', ') },
].filter((fact): fact is { label: string; value: string } => Boolean(fact.value));
const image = `/og/work/${entry.id}.png`;

// The pager always shows two destinations: a neighbouring case study, or the full list at either end.
const pager = [
  prev
    ? { href: `/work/${prev.id}`, eyebrow: 'Previous', title: prev.data.title, summary: prev.data.summary, dir: 'prev' }
    : { href: '/#work', eyebrow: 'All work', title: 'Back to selected work', dir: 'prev', fallback: true },
  next
    ? { href: `/work/${next.id}`, eyebrow: 'Next', title: next.data.title, summary: next.data.summary, dir: 'next' }
    : { href: '/#work', eyebrow: 'All work', title: 'Back to selected work', dir: 'next', fallback: true },
] as const;
---

<Base
  title={title}
  description={summary}
  image={image}
  type="article"
  jsonLd={articleJsonLd({ title, description: summary, url, image: new URL(image, Astro.site) })}
  glow
>
  <article>
    <header class="container-page pt-12 pb-12 md:pt-20 md:pb-16">
      <a href="/#work" class="tap group inline-flex items-center gap-1.5 text-sm text-muted hover:text-text">
        <Icon name="arrow-left" size={14} class="motion-safe:transition-transform motion-safe:group-hover:-translate-x-0.5" />
        Selected work
      </a>

      <div class="mt-10 grid gap-10 lg:grid-cols-12 lg:gap-12">
        <div class="lg:col-span-8">
          <p class="enter eyebrow">Case study</p>
          <h1 class="enter enter-1 mt-4 max-w-[24ch] text-2xl leading-[1.08] tracking-[-0.03em] text-balance md:text-3xl">
            {title}
          </h1>
          <p class="enter enter-2 mt-5 max-w-[60ch] text-md leading-relaxed text-muted">{summary}</p>
        </div>

        <dl class="case-facts enter enter-3 lg:col-span-4 lg:self-end">
          {
            facts.map((fact) => (
              <div>
                <dt class="eyebrow">{fact.label}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="enter enter-3 mt-10 md:mt-12">
        <MetricGrid flush>
          {metrics.slice(0, 3).map((metric) => <Metric value={metric.value} label={metric.label} />)}
        </MetricGrid>
      </div>
    </header>

    {
      sections.length > 1 && (
        <nav class="case-toc" aria-label="Sections" data-toc>
          <ul class="container-page flex gap-1">
            {sections.map((section) => (
              <li>
                <a href={`#${section.slug}`} class="case-toc-link">
                  {section.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <div class="container-page pt-12 pb-16 md:pt-16 md:pb-20">
      <div class="prose case-prose">
        <slot />
      </div>
    </div>

    <nav class="container-page" aria-label="More case studies">
      <div class="grid gap-3 pb-16 sm:grid-cols-2 md:pb-20">
        {
          pager.map((item) => (
            <a
              href={item.href}
              class:list={[
                'pager group',
                item.dir === 'next' && 'sm:text-right',
                // On one column, a real neighbour comes before the way back to the list.
                'fallback' in item && 'order-last sm:order-none',
              ]}
            >
              <span class:list={['eyebrow inline-flex items-center gap-1.5', item.dir === 'next' && 'sm:flex-row-reverse']}>
                <Icon
                  name={item.dir === 'prev' ? 'arrow-left' : 'arrow-right'}
                  size={12}
                  class:list={[
                    'motion-safe:transition-transform',
                    item.dir === 'prev' ? 'motion-safe:group-hover:-translate-x-0.5' : 'motion-safe:group-hover:translate-x-0.5',
                  ]}
                />
                {item.eyebrow}
              </span>
              <span class="mt-3 block text-base leading-snug font-medium text-text text-balance group-hover:text-accent-text">
                {item.title}
              </span>
              {'summary' in item && <span class="pager-summary">{item.summary}</span>}
            </a>
          ))
        }
      </div>
    </nav>
  </article>
</Base>

<style>
  /* Facts: a two-column band under the title on small screens, a stacked list beside it on wide ones. */
  .case-facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem 1.5rem;
    padding-block: 1.25rem;
    border-block: 1px solid var(--border);
    font-size: var(--text-sm);
  }
  .case-facts dd {
    margin-top: 0.375rem;
    color: var(--text);
    line-height: 1.5;
  }
  @media (min-width: 48rem) {
    .case-facts {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  @media (min-width: 64rem) {
    .case-facts {
      grid-template-columns: 1fr;
      gap: 0;
      padding-block: 0;
      border-block: 0;
    }
    .case-facts > div {
      display: grid;
      grid-template-columns: 6.5rem 1fr;
      gap: 1rem;
      align-items: baseline;
      padding-block: 0.75rem;
      border-top: 1px solid var(--border);
    }
    .case-facts > div:last-child {
      border-bottom: 1px solid var(--border);
    }
    .case-facts dd {
      margin-top: 0;
    }
  }

  /* Jump bar: sticks under the site header on wide screens so Results is one click away. */
  .case-toc {
    display: none;
  }
  @media (min-width: 48rem) {
    .case-toc {
      display: block;
      position: sticky;
      top: var(--header-h);
      z-index: 40;
      border-block: 1px solid var(--border);
      /* Nearly opaque where blur is unsupported, so body text never reads through the links. */
      background: color-mix(in oklab, var(--bg) 97%, transparent);
    }
    /* Same treatment as the site header. Only the unprefixed property: the CSS minifier folds a
       prefixed + unprefixed pair into the prefixed one, which Chrome ignores. */
    @supports (backdrop-filter: blur(1px)) {
      .case-toc {
        background: var(--header-bg);
        backdrop-filter: blur(14px) saturate(1.5);
      }
    }
  }
  .case-toc-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    height: 2.75rem;
    padding-inline: 0.75rem;
    font-size: var(--text-sm);
    color: var(--text-subtle);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .case-toc li:first-child .case-toc-link {
    padding-left: 0;
  }
  .case-toc-link:hover,
  .case-toc-link[aria-current='true'] {
    color: var(--text);
  }
  .case-toc-link[aria-current='true']::after {
    content: '';
    position: absolute;
    inset: auto 0.75rem -1px;
    height: 1px;
    background: var(--accent);
  }
  .case-toc li:first-child .case-toc-link[aria-current='true']::after {
    left: 0;
  }
  @media (min-width: 48rem) {
    .case-prose :global(:where(h2, h3, h4)) {
      scroll-margin-top: calc(var(--header-h) + 2.75rem + 1rem);
    }
  }

  /* Case-study reading rhythm, scoped here so the shared prose styles stay untouched. */
  .case-prose :global(h2) {
    letter-spacing: -0.02em;
  }
  .case-prose :global(h3) {
    margin-top: 2.5rem;
  }
  /* Each Approach section opens with its architecture figure: the system's shape before the details. */
  .case-prose :global(h2 + .arch-figure) {
    margin-top: 1.5rem;
  }
  /* The problem statement is the first thing a reviewer reads: give it full text color. */
  .case-prose :global(h2#problem + p) {
    color: var(--text);
    font-size: 1.125rem;
    line-height: 1.7;
  }

  .pager {
    display: flex;
    flex-direction: column;
    padding: 1.25rem 1.375rem 1.375rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface-1);
    transition: border-color var(--dur-fast) var(--ease-out);
  }
  .pager:hover {
    border-color: color-mix(in oklab, var(--accent) 40%, var(--border));
  }
  .pager-summary {
    display: -webkit-box;
    margin-top: 0.5rem;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    color: var(--text-subtle);
    font-size: var(--text-sm);
    line-height: 1.55;
  }
</style>
