---
import MetricValue from './MetricValue.astro';
import { getWork } from '~/lib/collections';
import { metrics } from '~/lib/site';

/**
 * Each headline number links to the case study that reports it, so every claim is one click
 * from its context. The match is on the case study's own metrics (same value, overlapping
 * label); a number with no matching case study simply isn't a link.
 */
const work = await getWork();
const words = (text: string) => new Set(text.toLowerCase().match(/[a-z0-9]+/g) ?? []);
const overlap = (a: string, b: string) => [...words(a)].filter((w) => words(b).has(w)).length;
const sourceOf = (value: string, label: string) =>
  work.find((entry) => entry.data.metrics.some((m) => m.value === value && overlap(m.label, label) >= 2));

const items = metrics.map((metric) => ({ ...metric, work: sourceOf(metric.value, metric.label) }));
---

<section class="container-page" aria-labelledby="impact-title">
  <h2 id="impact-title" class="sr-only">Impact in numbers</h2>
  <ul class="impact grid grid-cols-2 border-y border-border lg:grid-cols-4" data-reveal>
    {
      items.map((metric) => {
        const body = (
          <>
            <MetricValue
              value={metric.value}
              class="block text-[1.75rem] leading-none font-medium tracking-[-0.04em] text-text sm:text-2xl md:text-3xl"
            />
            <span class="impact-label mt-4 block text-sm leading-snug font-medium text-pretty text-text">{metric.label}</span>
            <span class="mt-1.5 block text-xs leading-normal text-subtle sm:text-sm">{metric.context}</span>
          </>
        );
        return (
          <li class="impact-item">
            {metric.work ? (
              <a
                href={`/work/${metric.work.id}`}
                class="impact-cell group"
                aria-label={`${metric.value} ${metric.label}. ${metric.context}. Read the case study.`}
              >
                {body}
              </a>
            ) : (
              <div class="impact-cell">{body}</div>
            )}
          </li>
        );
      })
    }
  </ul>
</section>

<style>
  .impact-cell {
    position: relative;
    display: block;
    height: 100%;
    padding-block: 1.5rem;
  }
  @media (min-width: 40rem) {
    .impact-cell {
      padding-block: 1.75rem;
    }
  }

  /* Two columns on small screens, four from lg; hairlines between cells. The outer cells
     sit flush with the container edge so the numbers line up with the hero text above. */
  .impact-item:nth-child(odd) .impact-cell {
    padding-right: 1rem;
  }
  .impact-item:nth-child(even) {
    border-left: 1px solid var(--border);
  }
  .impact-item:nth-child(even) .impact-cell {
    padding-left: 1rem;
  }
  .impact-item:nth-child(n + 3) {
    border-top: 1px solid var(--border);
  }
  @media (min-width: 40rem) {
    .impact-item:nth-child(odd) .impact-cell {
      padding-right: 1.5rem;
    }
    .impact-item:nth-child(even) .impact-cell {
      padding-left: 1.5rem;
    }
  }
  @media (min-width: 64rem) {
    .impact-item:nth-child(n + 3) {
      border-top: 0;
    }
    .impact-item + .impact-item {
      border-left: 1px solid var(--border);
    }
    .impact-item:nth-child(n) .impact-cell {
      padding-inline: 1.5rem;
    }
    .impact-item:first-child .impact-cell {
      padding-left: 0;
    }
  }

  /* The whole cell links to its case study. No icon per cell (four arrows read as a dashboard
     widget); hovering or focusing underlines the label instead. */
  .impact-label {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    transition: text-decoration-color var(--dur-fast) var(--ease-out);
  }
  .impact-cell:hover .impact-label,
  .impact-cell:focus-visible .impact-label {
    text-decoration-color: var(--accent);
  }
  .impact-cell:focus-visible {
    outline-offset: -2px;
  }
</style>
