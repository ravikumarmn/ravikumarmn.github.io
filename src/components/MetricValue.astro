---
/**
 * A headline number with its unit set smaller than the digits. The qualifier ("<") keeps the
 * digits' color and weight: in a latency claim it carries meaning, so it must not look faded.
 * Screen readers get the original string unchanged.
 * Values that aren't a number ("SQL + RAG") render as given.
 */
interface Props {
  value: string;
  class?: string;
}
const { value, class: className } = Astro.props;
const match = value.match(/^([<>~≈]?)([+\-−]?\d[\d.,]*)(.*)$/);
const [, qualifier = '', number = value, unit = ''] = match ?? [];
---

<span class:list={['metric-value', className]}>
  {qualifier && <span class="qualifier">{qualifier}</span>}{number}{unit && <span class="unit">{unit.trim()}</span>}
</span>

<style>
  .metric-value {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .qualifier {
    margin-right: 0.04em;
  }
  .unit {
    margin-left: 0.06em;
    font-size: 0.62em;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--text-muted);
  }
</style>
