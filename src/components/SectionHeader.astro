---
interface Props {
  id: string;
  eyebrow: string;
  title: string;
  lede?: string;
}
const { id, eyebrow, title, lede } = Astro.props;
---

<header class="max-w-2xl" data-reveal>
  <p class="eyebrow">{eyebrow}</p>
  <h2 id={`${id}-title`} class="mt-3 text-xl md:text-2xl">{title}</h2>
  {lede && <p class="mt-4 text-muted">{lede}</p>}
  <slot />
</header>
