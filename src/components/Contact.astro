---
import Icon from './Icon.astro';
import ResumeLink from './ResumeLink.astro';
import { profile } from '~/lib/site';
---

<section id="contact" class="section" aria-labelledby="contact-title">
  <div class="container-page" data-reveal>
    <p class="eyebrow">Contact</p>
    <h2 id="contact-title" class="mt-3 max-w-[22ch] text-2xl md:text-3xl">
      Building agents, retrieval, or LLM infrastructure? Let’s talk.
    </h2>
    <p class="mt-5 max-w-[56ch] text-muted">
      Email is the fastest way to reach me. Résumé and profiles are below.
    </p>

    <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center">
      <div class="email-box">
        <a href={`mailto:${profile.email}`} class="truncate font-mono text-sm text-text hover:text-accent-text sm:text-base">
          {profile.email}
        </a>
        <button type="button" class="copy-btn" data-copy={profile.email} aria-label="Copy email address">
          <Icon name="copy" class="copy-icon" />
          <Icon name="check" class="check-icon" />
          <span data-copy-label aria-live="polite">Copy</span>
        </button>
      </div>
      <ResumeLink />
    </div>

    <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-3 text-sm">
      {
        profile.links.map((link) => (
          <li>
            <a href={link.href} class="group inline-flex items-center gap-2 text-muted hover:text-text" rel="me noopener">
              <Icon name={link.icon} />
              {link.label}
              <span class="font-mono text-xs text-subtle">{link.handle}</span>
              <Icon name="arrow-up-right" size={14} class="text-subtle transition-transform group-hover:-translate-y-px group-hover:translate-x-px" />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .email-box {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
    height: 2.75rem;
    padding-left: 1rem;
    padding-right: 0.25rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--surface-1);
  }
  .copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    height: 2.25rem;
    padding-inline: 0.625rem;
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--text-muted);
    cursor: pointer;
  }
  .copy-btn:hover {
    background: var(--surface-2);
    color: var(--text);
  }
  .copy-btn .check-icon,
  .copy-btn[data-copied] .copy-icon {
    display: none;
  }
  .copy-btn[data-copied] .check-icon {
    display: block;
    color: var(--accent);
  }
</style>
