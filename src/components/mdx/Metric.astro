---
interface Props {
  value: string;
  label: string;
}
const { value, label } = Astro.props;
---

<div class="metric">
  <dt class="metric-label">{label}</dt>
  <dd class="metric-value">{value}</dd>
</div>

<style>
  .metric {
    display: flex;
    flex-direction: column-reverse;
    /* Top-align the numeral so values line up across a row even when a label wraps. */
    justify-content: flex-end;
    gap: 0.375rem;
    padding: 1.125rem 1.25rem 1.25rem;
    /* A 1px ring that fills the grid gap; the panel's overflow clips it at the outer edge. */
    box-shadow: 0 0 0 1px var(--border);
  }
  @media (min-width: 48rem) {
    .metric {
      padding: 1.5rem 1.5rem 1.375rem;
    }
  }
  .metric-value {
    color: var(--text);
    font-family: var(--font-mono);
    font-size: var(--text-xl);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.035em;
    line-height: 1.1;
  }
  @media (min-width: 48rem) {
    .metric-value {
      font-size: var(--text-2xl);
    }
  }
  .metric-label {
    max-width: 32ch;
    color: var(--text-subtle);
    font-size: var(--text-sm);
    line-height: 1.5;
  }
</style>
