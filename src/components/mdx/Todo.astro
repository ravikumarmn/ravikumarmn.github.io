---
/**
 * A visible placeholder for a fact the résumé doesn't provide.
 * `npm run audit:content` lists every one; STRICT_CONTENT=1 fails the build while any remain.
 */
interface Props {
  /** Shown when there is no slot content. */
  text?: string;
}
const { text } = Astro.props;
if (import.meta.env.PROD && process.env.STRICT_CONTENT === '1') {
  throw new Error(`Unresolved TODO in ${Astro.url.pathname}: ${text ?? '(see slot content)'}`);
}
---

<span class="todo" data-todo><span class="todo-tag">TODO</span>{text}<slot /></span>

<style>
  .todo {
    display: inline;
    padding: 0.05em 0.4em;
    border: 1px dashed var(--todo);
    border-radius: var(--radius-sm);
    background: var(--todo-soft);
    color: var(--todo);
    font-size: 0.92em;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }
  .todo-tag {
    margin-right: 0.4em;
    font-family: var(--font-mono);
    font-size: 0.75em;
    font-weight: 600;
    letter-spacing: 0.04em;
  }
</style>
