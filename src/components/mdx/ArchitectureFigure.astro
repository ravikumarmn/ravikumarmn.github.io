---
import Diagram from '../diagrams/Diagram.astro';
import type { DiagramSpec } from '~/lib/diagram';

interface Props {
  spec: DiagramSpec;
  caption: string;
}
const { spec, caption } = Astro.props;
---

<figure class="arch-figure not-prose">
  <div class="arch-scroll" tabindex="0" role="region" aria-label={`${spec.title} (scrollable)`}>
    <Diagram spec={spec} />
  </div>
  <figcaption>
    <span class="eyebrow shrink-0">Fig.</span>
    <span>
      {caption}<slot />
      <span class="arch-hint">Scroll sideways to see the whole diagram.</span>
    </span>
  </figcaption>
</figure>

<style>
  /* These rules sit on top of the generic .arch-* styles in prose.css (scoped, so they win). */
  .arch-figure {
    margin-block: 2.5rem 3rem;
  }
  .arch-scroll {
    overflow-x: auto;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(circle at 1px 1px, var(--border) 1px, transparent 0) 0 0 / 20px 20px,
      var(--surface-1);
    overscroll-behavior-x: contain;
  }
  .arch-scroll:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  /* Wide enough that node labels stay legible (about 11px) when the figure has to scroll. */
  .arch-scroll :global(.diagram) {
    display: block;
    width: 100%;
    min-width: 52rem;
    height: auto;
    margin-inline: auto;
  }
  @media (min-width: 48rem) {
    .arch-scroll {
      padding: 1.5rem;
    }
  }
  .arch-figure figcaption {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    max-width: var(--prose-max);
    margin-top: 0.875rem;
    color: var(--text-subtle);
    font-size: var(--text-sm);
    line-height: 1.6;
    text-align: left;
  }
  .arch-hint {
    display: block;
    margin-top: 0.25rem;
  }
  /* Past this width the whole diagram fits, so the hint is noise. */
  @media (min-width: 58.25rem) {
    .arch-hint {
      display: none;
    }
  }
</style>
