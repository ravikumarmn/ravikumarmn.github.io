---
/**
 * Wraps copy that was inferred rather than stated in the résumé.
 * In `astro dev` it is underlined so it's easy to review; in production it renders as plain text.
 * Remove the wrapper once the claim is confirmed (or rewrite it).
 */
interface Props {
  note?: string;
  /** Render as its own paragraph (for standalone lines in MDX). */
  block?: boolean;
}
const { note, block = false } = Astro.props;
const inner = await Astro.slots.render('default');
const title = (note ? `Verify: ${note}` : 'Verify: inferred from résumé').replace(/"/g, '&quot;');
const html = import.meta.env.DEV ? `<span class="verify" title="${title}">${inner}</span>` : inner;
---

{block ? <p set:html={html} /> : <Fragment set:html={html} />}

<style is:global>
  .verify {
    text-decoration: underline dotted var(--todo);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 4px;
    cursor: help;
  }
</style>
