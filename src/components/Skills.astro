---
import SectionHeader from './SectionHeader.astro';
import { skills } from '~/lib/site';
---

<section id="skills" class="section" aria-labelledby="skills-title">
  <div class="container-page grid-12 gap-y-10">
    <div class="col-span-12 lg:col-span-4">
      <SectionHeader
        id="skills"
        eyebrow="Toolkit"
        title="What I build with"
        lede="The tools behind the systems above, grouped by where they sit in the stack."
      />
    </div>

    <!-- A spec sheet rather than a tag cloud: one row per layer, tools as plain text. -->
    <dl class="col-span-12 border-b border-border lg:col-span-8" data-reveal>
      {
        skills.map((group) => (
          <div class="spec-row">
            <dt class="font-mono text-xs font-medium tracking-[0.06em] text-text uppercase">{group.group}</dt>
            <dd>
              <ul class="tools">
                {group.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .spec-row {
    display: grid;
    gap: 0.75rem;
    padding-block: 1.25rem;
    border-top: 1px solid var(--border);
  }
  @media (min-width: 40rem) {
    .spec-row {
      grid-template-columns: 11.5rem minmax(0, 1fr);
      gap: 1.5rem;
      padding-block: 1.375rem;
    }
    .spec-row dt {
      /* Optically align the small mono label with the first line of tools. */
      padding-top: 0.1875rem;
    }
  }

  /*
   * Tools read as a run of plain text with "/" between them. Each separator sits before its item,
   * and the list is pulled left under a clipping box, so a separator never starts or ends a line.
   */
  dd {
    overflow: hidden;
  }
  .tools {
    display: flex;
    flex-wrap: wrap;
    row-gap: 0.25rem;
    margin-left: -1.25rem;
    color: var(--text-muted);
    font-size: var(--text-sm);
    line-height: 1.6;
  }
  @media (min-width: 40rem) {
    .tools {
      font-size: 0.9375rem;
    }
  }
  .tools li {
    position: relative;
    padding-left: 1.25rem;
    white-space: nowrap;
  }
  .tools li::before {
    content: '/';
    content: '/' / '';
    position: absolute;
    left: 0;
    width: 1.25rem;
    text-align: center;
    color: var(--border-strong);
  }
</style>
