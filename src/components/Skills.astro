---
import SectionHeader from './SectionHeader.astro';
import { skills } from '~/lib/site';
---

<section id="skills" class="section" aria-labelledby="skills-title">
  <div class="container-page grid-12 gap-y-12">
    <div class="col-span-12 lg:col-span-4">
      <SectionHeader id="skills" eyebrow="Toolkit" title="What I build with" />
    </div>
    <div class="col-span-12 grid gap-10 sm:grid-cols-2 lg:col-span-8">
      {
        skills.map((group) => (
          <div data-reveal>
            <h3 class="font-mono text-xs font-medium tracking-[0.06em] text-text uppercase">{group.group}</h3>
            <ul class="mt-4 flex flex-wrap gap-1.5">
              {group.items.map((item) => (
                <li class="chip">{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
