---
import Icon from './Icon.astro';
import SectionHeader from './SectionHeader.astro';
import { building } from '~/lib/site';
---

<section id="projects" class="section pt-0 md:pt-0" aria-labelledby="projects-title">
  <div class="container-page">
    <SectionHeader
      id="projects"
      eyebrow="Projects"
      title="Open projects, published as I measure them"
      lede="Evaluation, fine-tuning and serving, and reinforcement learning. Each one builds on work I’ve done in production and is rebuilt in public on a single 24 GB GPU, with numbers anyone can reproduce."
    />

    <ol class="mt-10 grid gap-4 md:mt-12 md:grid-cols-3 md:gap-5">
      {
        building.map((project, i) => (
          <li data-reveal>
            <a href={`/projects#${project.slug}`} class="build-card group">
              <span class="flex items-center justify-between gap-4">
                <span class="font-mono text-xs text-subtle tabular-nums">0{i + 1}</span>
                <Icon
                  name="arrow-right"
                  size={16}
                  class="shrink-0 text-subtle transition-[color,transform] duration-200 group-hover:translate-x-0.5 group-hover:text-accent-text"
                />
              </span>
              <span class="mt-4 block font-medium text-pretty text-text">{project.title}</span>
              <span class="mt-2.5 block text-sm leading-relaxed text-muted">{project.summary}</span>
              <span class="mt-auto block pt-5 font-mono text-xs text-subtle">{project.stack.slice(0, 3).join(' · ')}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .build-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface-1);
    transition:
      border-color var(--dur) var(--ease-out),
      box-shadow var(--dur) var(--ease-out);
  }
  .build-card:hover {
    border-color: color-mix(in oklab, var(--accent) 40%, var(--border));
    box-shadow: var(--shadow-lift);
  }
</style>
