---
import Icon from './Icon.astro';
import SectionHeader from './SectionHeader.astro';
import WorkCard from './WorkCard.astro';
import { getWork } from '~/lib/collections';
import { projects } from '~/lib/site';

const work = await getWork();
---

<section id="work" class="section" aria-labelledby="work-title">
  <div class="container-page">
    <SectionHeader
      id="work"
      eyebrow="Selected work"
      title="Systems I’ve designed and shipped"
      lede="Each case study covers the problem, the constraints, the trade-offs, and the numbers."
    />

    {/* The first case study leads across the full row from lg; the rest sit three across. */}
    <ul class="mt-10 grid gap-4 md:mt-12 md:grid-cols-2 md:gap-5 lg:grid-cols-3">
      {
        work.map((entry, i) => (
          <li class:list={{ 'lg:col-span-3': i === 0 }}>
            <WorkCard entry={entry} featured={i === 0} />
          </li>
        ))
      }
    </ul>

    <div class="mt-16 md:mt-20" data-reveal>
      <h3 class="eyebrow">Also built</h3>
      <ul class="mt-4 grid border-t border-border md:grid-cols-2 md:gap-x-10">
        {
          projects.map((project) => (
            <li class="border-b border-border py-4">
              <div class="flex flex-col gap-0.5 sm:flex-row sm:flex-wrap sm:items-baseline sm:justify-between sm:gap-x-4">
                <p class="font-medium text-text">
                  {project.href ? (
                    <a href={project.href} class="link inline-flex items-center gap-1">
                      {project.title}
                      <Icon name="arrow-right" size={14} />
                    </a>
                  ) : (
                    project.title
                  )}
                </p>
                <p class="font-mono text-xs text-muted">{project.metric}</p>
              </div>
              <p class="mt-1 text-sm text-subtle">{project.detail}</p>
              <p class="mt-2 font-mono text-xs text-subtle">{project.stack}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
