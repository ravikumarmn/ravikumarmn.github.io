---
import Icon from './Icon.astro';
import SectionHeader from './SectionHeader.astro';
import { getPosts } from '~/lib/collections';

const posts = await getPosts();
const featured = posts.filter((post) => post.data.featured).slice(0, 4);
---

{
  featured.length > 0 && (
    <section id="writing" class="section" aria-labelledby="writing-title">
      <div class="container-page grid-12 gap-y-10">
        <div class="col-span-12 lg:col-span-4">
          <SectionHeader
            id="writing"
            eyebrow="Writing"
            title="Notes from the bench"
            lede="Explainers with working code: retrieval, transformers, and the PyTorch underneath."
          >
            <a href="/writing" class="link mt-6 inline-flex items-center gap-1.5 text-sm">
              All {posts.length} posts <Icon name="arrow-right" size={14} />
            </a>
          </SectionHeader>
        </div>
        <ul class="col-span-12 border-t border-border lg:col-span-8" data-reveal>
          {featured.map((post) => (
            <li class="border-b border-border">
              <a href={`/blogs/${post.id}`} class="post-row group">
                <span class="font-mono text-xs text-subtle tabular-nums">{post.data.date.getFullYear()}</span>
                <span class="min-w-0">
                  <span class="block font-medium text-text group-hover:text-accent-text">{post.data.title}</span>
                  <span class="mt-0.5 block text-sm text-subtle">{post.data.topic}</span>
                </span>
                <Icon
                  name="arrow-up-right"
                  size={16}
                  class="text-subtle transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
                />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  .post-row {
    display: grid;
    grid-template-columns: 3.5rem 1fr auto;
    align-items: baseline;
    gap: 1rem;
    padding: 1.125rem 0.5rem;
    margin-inline: -0.5rem;
    border-radius: var(--radius-sm);
    transition: background-color var(--dur-fast) var(--ease-out);
  }
  .post-row:hover {
    background: var(--surface-1);
  }
</style>
