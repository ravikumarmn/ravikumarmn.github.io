---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import MetricValue from './MetricValue.astro';
import Diagram from './diagrams/Diagram.astro';
import { diagramsBySlug } from './diagrams/specs';

interface Props {
  entry: CollectionEntry<'work'>;
  /** The lead case study: spans the row on wide screens, with the diagram beside the text. */
  featured?: boolean;
}
const { entry, featured = false } = Astro.props;
const { title, summary, org, period, metrics, stack } = entry.data;
const diagram = diagramsBySlug[entry.id];
const shownMetrics = metrics.slice(0, featured ? 3 : 2);
const shownStack = stack.slice(0, featured ? 5 : 3);
---

<a href={`/work/${entry.id}`} class:list={['work-card group', { featured }]} data-reveal>
  {
    diagram && (
      <div class="work-preview">
        <Diagram spec={diagram} decorative />
      </div>
    )
  }
  <div class="work-body">
    <div class="flex items-start justify-between gap-4">
      <p class="eyebrow">
        {
          [org, period]
            .filter(Boolean)
            .map((part, i) => (
              <>
                {i > 0 && ' · '}
                <span class="whitespace-nowrap">{part}</span>
              </>
            ))
        }
      </p>
      <Icon
        name="arrow-up-right"
        size={18}
        class="-mt-0.5 shrink-0 text-subtle transition-[color,transform] duration-200 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-accent-text"
      />
    </div>
    <h3 class="work-title mt-3 text-text">{title}</h3>
    <p class="work-summary mt-3 text-muted">{summary}</p>

    <dl class="work-metrics">
      {
        shownMetrics.map((metric, i) => (
          <div class:list={['flex flex-col-reverse justify-end gap-1.5', { 'max-lg:hidden': i >= 2 }]}>
            <dt class="text-sm leading-snug text-subtle">{metric.label}</dt>
            <dd>
              <MetricValue
                value={metric.value}
                class="text-xl leading-none font-medium tracking-[-0.03em] text-text"
              />
            </dd>
          </div>
        ))
      }
    </dl>

    <ul class="mt-6 flex flex-wrap gap-1.5" aria-label="Stack">
      {shownStack.map((item, i) => <li class:list={['chip', { 'max-lg:hidden': i >= 3 }]}>{item}</li>)}
    </ul>
  </div>
  <span class="sr-only">Read case study</span>
</a>

<style>
  .work-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface-1);
    transition:
      border-color var(--dur) var(--ease-out),
      box-shadow var(--dur) var(--ease-out),
      translate var(--dur) var(--ease-out);
  }
  .work-card:hover {
    border-color: color-mix(in oklab, var(--accent) 40%, var(--border));
    box-shadow: var(--shadow-lift);
  }
  /* Keep the card's own corners when focused (the global ring uses the small radius). */
  .work-card:focus-visible {
    border-radius: var(--radius-lg);
    outline-offset: 2px;
  }

  /* The case study's own architecture diagram, shrunk to a schematic. */
  .work-preview {
    height: 8.5rem;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--border);
    background:
      radial-gradient(circle at 1px 1px, var(--border) 1px, transparent 0) 0 0 / 16px 16px,
      var(--bg);
  }
  @media (min-width: 48rem) {
    .work-preview {
      height: 11rem;
      padding: 1.5rem 2rem;
    }
  }
  .work-preview :global(.diagram) {
    width: 100%;
    height: 100%;
    transition: transform var(--dur-reveal) var(--ease-out);
  }
  /* Text is unreadable at this scale, so the preview is a pure schematic: boxes, wires, and
     the system's key component in the accent color. Strokes stay 1px whatever the scale. */
  .work-preview :global(text) {
    display: none;
  }
  .work-preview :global(rect),
  .work-preview :global(polyline) {
    vector-effect: non-scaling-stroke;
  }
  .work-preview :global(.dg-node rect) {
    fill: var(--surface-2);
    stroke: color-mix(in oklab, var(--text-subtle) 55%, var(--border-strong));
  }
  .work-preview :global(.dg-node.accent rect) {
    fill: color-mix(in oklab, var(--accent) 22%, var(--surface-2));
    stroke: var(--accent);
  }
  .work-preview :global(.dg-edge polyline) {
    stroke: color-mix(in oklab, var(--text-subtle) 70%, transparent);
  }
  .work-card:hover .work-preview :global(.dg-edge polyline) {
    stroke: color-mix(in oklab, var(--accent) 70%, var(--text-subtle));
  }

  .work-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 1.25rem 1.25rem 1.5rem;
  }
  @media (min-width: 48rem) {
    .work-body {
      padding: 1.5rem 1.75rem 1.75rem;
    }
  }

  .work-title {
    font-size: var(--text-md);
    line-height: 1.25;
    letter-spacing: -0.02em;
  }
  .work-summary {
    font-size: var(--text-sm);
    line-height: 1.6;
  }
  @media (min-width: 40rem) {
    .work-summary {
      font-size: var(--text-base);
    }
  }
  /* Three across from lg: narrower cards take a slightly smaller summary and tighter padding. */
  @media (min-width: 64rem) {
    .work-card:not(.featured) .work-summary {
      font-size: var(--text-sm);
    }
    .work-card:not(.featured) .work-body {
      padding: 1.5rem 1.5rem 1.75rem;
    }
  }

  /* Pin metrics and stack to the bottom so cards in a row line up. */
  .work-metrics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
    margin-top: auto;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
  }
  .work-summary {
    margin-bottom: 1.75rem;
  }

  /* Lead card: from lg it spans the row, text on the left and a larger diagram on the right. */
  @media (min-width: 64rem) {
    .featured {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    }
    .featured .work-preview {
      grid-column: 2;
      grid-row: 1;
      height: auto;
      min-height: 100%;
      padding: 2.5rem 2.75rem;
      border-bottom: 0;
      border-left: 1px solid var(--border);
    }
    .featured .work-body {
      grid-column: 1;
      grid-row: 1;
      padding: 2.25rem 2.5rem 2.5rem;
    }
    .featured .work-title {
      font-size: var(--text-lg);
      line-height: 1.2;
      letter-spacing: -0.025em;
    }
    .featured .work-metrics {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .featured .work-metrics :global(.metric-value) {
      font-size: var(--text-2xl);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .work-card:hover {
      translate: 0 -2px;
    }
    .work-card:hover .work-preview :global(.diagram) {
      transform: scale(1.025);
    }
  }
</style>
