---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import MaybeTodo from './MaybeTodo.astro';
import Diagram from './diagrams/Diagram.astro';
import { diagramsBySlug } from './diagrams/specs';

interface Props {
  entry: CollectionEntry<'work'>;
}
const { entry } = Astro.props;
const { title, summary, org, period, metrics, stack } = entry.data;
const diagram = diagramsBySlug[entry.id];
---

<a href={`/work/${entry.id}`} class="work-card group" data-reveal>
  {
    diagram && (
      <div class="work-preview">
        <Diagram spec={diagram} decorative />
      </div>
    )
  }
  <div class="work-body">
    <div class="flex items-start justify-between gap-4">
      <p class="eyebrow"><MaybeTodo value={org} /> · <MaybeTodo value={period} /></p>
      <Icon
        name="arrow-up-right"
        size={18}
        class="shrink-0 text-subtle transition-[color,transform] duration-200 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-accent"
      />
    </div>
    <h3 class="mt-4 text-lg leading-snug">{title}</h3>
    <p class="mt-3 mb-8 text-muted">{summary}</p>

    <dl class="grid grid-cols-2 gap-6 border-t border-border pt-6">
      {
        metrics.slice(0, 2).map((metric) => (
          <div class="flex flex-col-reverse justify-end gap-1">
            <dt class="text-sm text-subtle">{metric.label}</dt>
            <dd class="font-mono text-xl font-medium tracking-[-0.03em] text-text tabular-nums">{metric.value}</dd>
          </div>
        ))
      }
    </dl>

    <ul class="mt-6 flex flex-wrap gap-1.5" aria-label="Stack">
      {stack.slice(0, 4).map((item) => <li class="chip">{item}</li>)}
    </ul>
  </div>
  <span class="sr-only">Read case study</span>
</a>

<style>
  .work-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface-1);
    transition:
      border-color var(--dur) var(--ease-out),
      box-shadow var(--dur) var(--ease-out),
      translate var(--dur) var(--ease-out);
  }
  .work-card:hover {
    border-color: color-mix(in oklab, var(--accent) 40%, var(--border));
    box-shadow: var(--shadow-lift);
  }

  /* The case study's own architecture diagram, shrunk to a schematic. */
  .work-preview {
    height: 10rem;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--border);
    background:
      radial-gradient(circle at 1px 1px, var(--border) 1px, transparent 0) 0 0 / 16px 16px,
      var(--bg);
  }
  @media (min-width: 48rem) {
    .work-preview {
      height: 12rem;
      padding: 1.5rem 2.5rem;
    }
  }
  .work-preview :global(.diagram) {
    width: 100%;
    height: 100%;
    transition: transform var(--dur-reveal) var(--ease-out);
  }
  /* Text is unreadable at this scale, so the preview is a pure schematic: boxes, wires, and
     the system's key component in the accent color. Strokes stay 1px whatever the scale. */
  .work-preview :global(text) {
    display: none;
  }
  .work-preview :global(rect),
  .work-preview :global(polyline) {
    vector-effect: non-scaling-stroke;
  }
  .work-preview :global(.dg-node rect) {
    fill: var(--surface-2);
    stroke: color-mix(in oklab, var(--text-subtle) 55%, var(--border-strong));
  }
  .work-preview :global(.dg-node.accent rect) {
    fill: color-mix(in oklab, var(--accent) 22%, var(--surface-2));
    stroke: var(--accent);
  }
  .work-preview :global(.dg-edge polyline) {
    stroke: color-mix(in oklab, var(--text-subtle) 70%, transparent);
  }
  .work-card:hover .work-preview :global(.dg-edge polyline) {
    stroke: color-mix(in oklab, var(--accent) 70%, var(--text-subtle));
  }

  .work-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 1.5rem;
  }
  @media (min-width: 48rem) {
    .work-body {
      padding: 1.75rem 2rem 2rem;
    }
  }
  /* Pin metrics and stack to the bottom so cards in a row line up. */
  .work-body dl {
    margin-top: auto;
  }

  @media (prefers-reduced-motion: no-preference) {
    .work-card:hover {
      translate: 0 -2px;
    }
    .work-card:hover .work-preview :global(.diagram) {
      transform: scale(1.025);
    }
  }
</style>
