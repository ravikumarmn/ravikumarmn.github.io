---
/** Opens the résumé (hosted on Google Drive; the URL lives in profile.json) in a new tab. */
import Icon from './Icon.astro';
import { profile } from '~/lib/site';

interface Props {
  variant?: 'primary' | 'secondary';
  size?: 'sm' | 'md';
  class?: string;
}

const { variant = 'secondary', size = 'md', class: className } = Astro.props;
---

<a
  href={profile.resume}
  class:list={['btn', `btn-${variant}`, `btn-${size}`, className]}
  target="_blank"
  rel="noopener"
  aria-label="Résumé (opens in a new tab)"
>
  <Icon name="file-text" />
  Résumé
</a>
