---
/** Downloads the résumé PDF, which the build generates from /resume (scripts/build-resume-pdf.mjs). */
import Icon from './Icon.astro';
import { profile } from '~/lib/site';

interface Props {
  variant?: 'primary' | 'secondary';
  size?: 'sm' | 'md';
  class?: string;
}

const { variant = 'secondary', size = 'md', class: className } = Astro.props;
---

<a
  href={profile.resume}
  class:list={['btn', `btn-${variant}`, `btn-${size}`, className]}
  download="Ravikumar-MN-Resume.pdf"
>
  <Icon name="file-text" />
  Résumé
</a>
