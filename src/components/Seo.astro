---
import { profile } from '~/lib/site';

export interface Props {
  title?: string;
  description?: string;
  /** Path to a 1200×630 image, relative to the site root. */
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const {
  title,
  description = profile.seoDescription,
  image = '/og/home.png',
  type = 'website',
  publishedTime,
  jsonLd,
  noindex = false,
} = Astro.props;

const site = Astro.site!;
const fullTitle = title ? `${title} · ${profile.name}` : `${profile.name} · ${profile.title}`;
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/'), site);
const imageUrl = new URL(image, site);
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={profile.name} />
<link rel="canonical" href={canonical} />
{noindex ? <meta name="robots" content="noindex" /> : <meta name="robots" content="index, follow, max-image-preview:large" />}
{profile.links.map((link) => <link rel="me" href={link.href} />)}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={profile.name} />
<meta property="og:locale" content="en_US" />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={fullTitle} />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{type === 'article' && <meta property="article:author" content={site.href} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={fullTitle} />

{ld.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
