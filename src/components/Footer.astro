---
import { profile } from '~/lib/site';

const year = new Date().getFullYear();
const updated = new Date().toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
---

<footer class="border-t border-border">
  <div class="container-page flex flex-col gap-2 py-8 text-sm text-subtle sm:flex-row sm:items-center sm:justify-between">
    <p>© {year} {profile.name}</p>
    <p class="font-mono text-xs">
      Built with Astro · Updated {updated} ·
      <a class="link" href="https://github.com/ravikumarmn/ravikumarmn.github.io">Source</a>
    </p>
  </div>
</footer>
